# ============================================================================
# LabTutor environment configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets to this repo.
#
# Adding creds here and running `docker compose up` is the entire
# deployment procedure -- see README.md "Deployment".
# ============================================================================

# --- Core ---------------------------------------------------------------
# Public origin the app is served from (used to build OAuth redirect URIs).
LABTUTOR_PUBLIC_URL=https://labtutor.example.ac.in
# Signs session cookies. Generate with: openssl rand -hex 32
LABTUTOR_SESSION_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# development | production. Controls cookie Secure flag + error verbosity.
LABTUTOR_ENV=production

# --- Database -----------------------------------------------------------
POSTGRES_USER=labtutor
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=labtutor
# Host/port as seen from the backend container.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Role domains -------------------------------------------------------
# Server-side role determination reads these. They are environment
# variables specifically so an additional/corrected domain can be added
# WITHOUT a code change (see backend/auth/roles.py). Comma-separated;
# matching is case-insensitive and exact on the domain part of the email.
LABTUTOR_STUDENT_DOMAINS=vitstudent.ac.in
LABTUTOR_FACULTY_DOMAINS=vit.ac.in

# --- Google OAuth -------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${LABTUTOR_PUBLIC_URL}/api/auth/callback
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME_google_client_secret

# --- LLM inference backend ----------------------------------------------
# Which backend to use: "hosted" (primary, for the pilot) or "ollama"
# (local dev/fallback only -- NOT recommended for 70 concurrent users,
# see README "Inference backends").
LABTUTOR_LLM_BACKEND=hosted

# Hosted backend. Provider-agnostic: any OpenAI-compatible chat
# completions endpoint (Cerebras, Groq, OpenAI, Together, ...).
# The provider is NOT hardcoded anywhere in the code.
LABTUTOR_LLM_BASE_URL=https://api.cerebras.ai/v1
LABTUTOR_LLM_API_KEY=CHANGEME_hosted_llm_api_key
LABTUTOR_LLM_MODEL=llama-3.3-70b
LABTUTOR_LLM_TIMEOUT_SECONDS=30
LABTUTOR_LLM_MAX_TOKENS=400

# Ollama fallback (dev only).
LABTUTOR_OLLAMA_BASE_URL=http://ollama:11434
LABTUTOR_OLLAMA_MODEL=llama3.1:8b

# If the primary backend fails, automatically fall back to Ollama when
# it is reachable. If false, failures surface as maintenance-mode
# degraded responses instead. See README "Rollback plan".
LABTUTOR_LLM_AUTO_FALLBACK=true

# --- Retrieval ----------------------------------------------------------
# Path to the course manual PDF, mounted into the backend container.
# Retrieval and every Tier 1 experiment plugin are derived from THIS file.
LABTUTOR_MANUAL_PDF=/app/manual/BACHY105.pdf

# --- Rate limiting ------------------------------------------------------
# Per-user limits protecting the inference backend.
LABTUTOR_RATELIMIT_SOCRATIC_PER_MINUTE=12
LABTUTOR_RATELIMIT_SUBMIT_PER_HOUR=30

# --- Summaries ----------------------------------------------------------
# Concurrency of the async per-student summary job.
LABTUTOR_SUMMARY_WORKERS=4
